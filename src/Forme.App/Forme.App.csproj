<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Forme</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Forme.App.Program</StartupObject>
    <ApplicationIcon>Assets/forme.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Avoid decompressing framework assemblies into private memory on every launch. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FormeDevelopmentTools)' == 'true'">
    <DefineConstants>$(DefineConstants);FORME_DEVELOPMENT_TOOLS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(FormeDevelopmentTools)' != 'true'">
    <Compile Remove="Probe.cs;PetAnimationChecks.cs;CompanionChecks.cs;BoatChecks.cs;LivingChecks.cs;ActivitySelectionChecks.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <ProjectReference Include="../Forme.Core/Forme.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/forme.ico" LogicalName="Forme.Icon" />
    <EmbeddedResource Include="Assets/PetModels/space-marine.glb" LogicalName="Forme.SpaceMarine.glb" />
    <EmbeddedResource Include="Assets/PetModels/rpg-ranger.glb" LogicalName="Forme.Pet.Ranger.glb" />
    <EmbeddedResource Include="Assets/PetModels/rpg-cleric.glb" LogicalName="Forme.Pet.Cleric.glb" />
    <EmbeddedResource Include="Assets/PetModels/rpg-warrior.glb" LogicalName="Forme.Pet.Warrior.glb" />
    <EmbeddedResource Include="Assets/PetModels/umw-adventurer.glb" LogicalName="Forme.Pet.Women.Adventurer.glb" />
    <EmbeddedResource Include="Assets/PetModels/umw-casual.glb" LogicalName="Forme.Pet.Women.Casual.glb" />
    <EmbeddedResource Include="Assets/PetModels/umw-formal.glb" LogicalName="Forme.Pet.Women.Formal.glb" />
    <EmbeddedResource Include="Assets/PetModels/anime-rose.vrm" LogicalName="Forme.Pet.Anime.Rose.vrm" />
    <EmbeddedResource Include="Assets/PetModels/anime-olivia.vrm" LogicalName="Forme.Pet.Anime.Olivia.vrm" />
    <EmbeddedResource Include="Assets/PetModels/anime-kate.vrm" LogicalName="Forme.Pet.Anime.Kate.vrm" />
  </ItemGroup>
  <ItemGroup><Using Include="System"/><Using Include="System.IO"/><Using Include="System.Linq"/><Using Include="System.Collections.Generic"/><Using Include="System.Threading"/><Using Include="System.Threading.Tasks"/></ItemGroup>
</Project>
